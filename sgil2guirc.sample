### Settings file: ~/.sgil2guirc

host          = 192.168.0.100
# the L2's command port
l2port        = 8000
# L2 password, only if the L2 has one (l2passwd). no comment on this line!
password      =
# L2 Terminal: 1 = console port 8003 (sessions not logged), 0 = 8001
consolequiet  = 0
timeout       = 30            # seconds to wait for a command's response
sort          = desc          # desc | asc | custom
sortorder     = 001c01 001c02 001c03 001c04 001r20
routerstyle   = default       # default | altix
altix350style = yellow        # yellow | grey
refresh       = 0             # auto refresh interval in seconds, 0 = off
confirmpower  = 1
